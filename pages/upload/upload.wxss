/* pages/upload/upload.wxss - 上传页样式 */

.container {
  padding: 40rpx 32rpx;
}

/* 选择区域 */
.picker-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 480rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  background-color: #fafafa;
}

.picker-area:active {
  background-color: #f0f0f0;
}

.picker-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.picker-text {
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.picker-hint {
  font-size: 24rpx;
  color: #bbb;
}

/* 预览 */
.preview-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-image {
  width: 100%;
  height: 520rpx;
  border-radius: 12rpx;
  background-color: #e0e0e0;
}

.rechoose {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #4a90d9;
}

.rechoose:active {
  color: #3a7bc8;
}

/* 上传按钮 */
.action-area {
  margin-top: 60rpx;
}

.upload-btn {
  width: 100%;
}
