/* pages/index/index.wxss - 照片墙样式 */

.container {
  padding-bottom: 140rpx;
}

/* 顶部 */
.header {
  padding: 32rpx 32rpx 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* 照片网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.grid-item {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
}

.photo {
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 正方形 */
  border-radius: 8rpx;
  background-color: #e0e0e0;
  display: block;
}

/* 加载提示 */
.loading-msg {
  display: flex;
  justify-content: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}

/* 悬浮上传按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #4a90d9;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
  background-color: #3a7bc8;
}

.fab-icon {
  font-size: 52rpx;
  color: #fff;
  line-height: 1;
  font-weight: 300;
}
